# secrets.yml.template
# 
# INSTRUCTIONS FOR TEAM MEMBERS:
# 1. Copy this file to 'secrets.yml' in the same directory
# 2. Replace all placeholder values with your actual secrets
# 3. NEVER commit secrets.yml to git (it's in .gitignore)
#
# Command to copy: cp secrets.yml.template secrets.yml

# ===== DATABASE SECRETS =====
spring:
  datasource:
    # Replace with your actual PostgreSQL database credentials
    username: examvault_user           # Your PostgreSQL username
    password: examvault_password       # Your PostgreSQL password

# ===== OAUTH SECRETS =====
spring:
  security:
    oauth2:
      client:
        registration:
          google:
            # Get these from Google Cloud Console:
            # https://console.cloud.google.com/apis/credentials
            # 1. Create OAuth 2.0 Client ID
            # 2. Add redirect URI: http://localhost:8080/login/oauth2/code/google
            client-id: your-google-oauth-client-id-here
            client-secret: your-google-oauth-client-secret-here

---
# ===== DEVELOPMENT ENVIRONMENT SECRETS =====
spring:
  config:
    activate:
      on-profile: development

spring:
  datasource:
    # Development database credentials (can be same as above or different)
    username: examvault_user           # Dev database username
    password: examvault_password       # Dev database password

  security:
    oauth2:
      client:
        registration:
          google:
            # Development OAuth credentials (can be same as above or separate dev credentials)
            client-id: your-google-oauth-client-id-here
            client-secret: your-google-oauth-client-secret-here

---
# ===== TEST ENVIRONMENT SECRETS =====
spring:
  config:
    activate:
      on-profile: test

spring:
  security:
    oauth2:
      client:
        registration:
          google:
            # Simple test OAuth credentials (these can be fake for testing)
            client-id: test-client-id
            client-secret: test-client-secret

---
# ===== PRODUCTION ENVIRONMENT SECRETS =====
# Note: In production, use environment variables for security
spring:
  config:
    activate:
      on-profile: production

spring:
  datasource:
    # Production database credentials - use environment variables with fallbacks
    username: ${DB_USERNAME:your-production-db-username}
    password: ${DB_PASSWORD:your-production-db-password}

  security:
    oauth2:
      client:
        registration:
          google:
            # Production OAuth credentials - use environment variables
            client-id: ${GOOGLE_CLIENT_ID:your-production-google-client-id}
            client-secret: ${GOOGLE_CLIENT_SECRET:your-production-google-client-secret}
